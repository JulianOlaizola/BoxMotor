# Variables de entorno de ejemplo (valores ficticios, no secretos reales)
# Copiar a .env y completar con valores reales en cada entorno.

# Backend
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/boxmotor?sslmode=require
FRONTEND_URL=http://localhost:5173
JWT_SECRET=cambiar_por_un_secreto_fuerte_y_aleatorio_en_produccion
JWT_EXPIRES_IN=7d
NODE_ENV=development
PORT=4000
ADMIN_BOOTSTRAP_EMAIL=admin@boxmotor.demo
ADMIN_BOOTSTRAP_PASSWORD=AdminDemo123

# Reglas de negocio (configurables)
